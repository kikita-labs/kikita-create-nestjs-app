# Copy to .env and fill in real values. Every var here must have a matching entry in the
# Zod schema passed to ConfigModule.forRoot({ validate }) — see .agents/code-style/dto-and-validation.md.

# App
NODE_ENV=development
PORT=3000

# REST-only: comma-separated allowlist, never *
# SCAFFOLD: keep only if REST or both was chosen
CORS_ORIGIN=http://localhost:4200

# Database (Prisma + Postgres, always present)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public

# SCAFFOLD: keep only if auth was chosen
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL=30d
CSRF_SECRET=change-me-as-well

# SCAFFOLD: keep only if bot (or both) was chosen
BOT_PLATFORM_TOKEN=change-me

# SCAFFOLD: keep only if background jobs or caching was chosen
REDIS_URL=redis://localhost:6379

# SCAFFOLD: keep only if caching was chosen
CACHE_TTL_SECONDS=60

# SCAFFOLD: keep only if file uploads was chosen
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# SCAFFOLD: keep only if messaging was chosen
RABBITMQ_URL=amqp://guest:guest@localhost:5672
